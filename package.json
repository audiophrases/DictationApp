{
  "name": "dictationapp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "start": "node server/serve.js",
    "icons": "node scripts/make-icons.mjs",
    "pack:win": "npm run build && node scripts/pack-win.mjs",
    "deploy:assignments": "wrangler deploy --config cloudflare/wrangler.toml --keep-vars",
    "cloudflare:login": "wrangler login",
    "test:worker": "node cloudflare/worker.test.mjs",
    "test:score": "node src/lib/score.test.mjs",
    "test:grading": "node src/lib/grading.test.mjs",
    "test:student-auth": "node --test src/lib/studentAuth.test.mjs",
    "test:audio-cache": "node --test src/lib/assignmentAudioCache.test.mjs",
    "test:dictation": "node server/dictation.test.mjs",
    "test:sentences": "node src/lib/sentences.test.mjs",
    "test:recording-sessions": "node --test src/lib/pinplaySessions.test.mjs src/lib/spokenPunctuation.test.mjs",
    "test:audio-splits": "node --test src/lib/audioSplits.test.mjs src/lib/reuseAudio.test.mjs src/lib/wordAlignment.test.mjs",
    "test:notebook": "node --test src/lib/notebook.test.mjs",
    "test:listening-studio": "node --test src/lib/listeningStudio.test.mjs server/listeningStudio.test.mjs",
    "test": "npm run test:sentences && npm run test:notebook && npm run test:audio-splits && npm run test:listening-studio && npm run test:recording-sessions && npm run test:score && npm run test:grading && npm run test:student-auth && npm run test:audio-cache && npm run test:dictation && npm run test:worker"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "compromise": "^14.19.0",
    "diff": "^9.0.0",
    "lucide-react": "^1.25.0",
    "msedge-tts": "^2.1.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "esbuild": "^0.28.1",
    "oxlint": "^1.71.0",
    "vite": "^8.1.1",
    "wrangler": "4.151.3"
  }
}
