# Output of `npm run pack:win` — contains a copied node.exe (~87 MB) and the
# zip built from it. Rebuild it, don't commit it.
pack

# Cloudflare Worker: local secrets and wrangler's build/state directory.
# .dev.vars holds the roster secret and the teacher password hash;
# secrets.local.json is the same values in the shape `wrangler secret bulk`
# wants. Keep a copy somewhere safe outside the repo — Cloudflare secrets are
# write-only and cannot be read back once set.
cloudflare/.dev.vars
cloudflare/secrets.local.json
.wrangler

